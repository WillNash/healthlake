# environments/prod/terraform.tfvars.example
#
# Copy to terraform.tfvars and fill in the required values.
# Do NOT commit terraform.tfvars — it contains sensitive values.
# Add terraform.tfvars to .gitignore.
#
# Sensitive variables (redcap_url, redcap_project_id) should be passed
# via environment variables to avoid storing them on disk:
#   export TF_VAR_redcap_url="https://redcap.example.com"
#   export TF_VAR_redcap_project_id="42"

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

aws_region = "ap-southeast-2"

# Set via TF_VAR_redcap_url — do not put the value here
# redcap_url = ""

# Set via TF_VAR_redcap_project_id — do not put the value here
# redcap_project_id = ""

# ---------------------------------------------------------------------------
# Optional overrides (defaults shown)
# ---------------------------------------------------------------------------

project_name = "clinical-registry"

# Map of REDCap project IDs to registry names.
# registry_map = { "1001" = "ovarian_cancer", "1002" = "cardiac_surgery" }

export_schedule_expression = "cron(0 2 * * ? *)"
