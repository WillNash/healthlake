# environments/prod/terraform.tfvars.example
#
# Copy to terraform.tfvars and fill in the required values.
# Do NOT commit terraform.tfvars — it is gitignored.
#
# redcap_projects is sensitive — set via TF_VAR_redcap_projects or keep it
# in a separate gitignored file passed with -var-file.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

aws_region = "ap-southeast-2"

# ---------------------------------------------------------------------------
# Optional overrides (defaults shown)
# ---------------------------------------------------------------------------

project_name = "clinical-registry"

# Leave empty ({}) for simulate mode.
# Add one entry per REDCap project when connecting live instances.
# The key must match a registry name known to the mapper.
#
# redcap_projects = {
#   ovarian_cancer = {
#     url        = "https://redcap.hospital-a.com"
#     project_id = "42"
#   }
#   cardiac_surgery = {
#     url                 = "https://redcap.hospital-b.com"
#     project_id          = "17"
#     schedule_expression = "cron(0 3 * * ? *)"  # optional, defaults to 2 AM UTC
#   }
# }

# Map of REDCap project IDs to registry names for the transformation side.
# registry_map = { "42" = "ovarian_cancer", "17" = "cardiac_surgery" }
